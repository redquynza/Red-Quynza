---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;      // imagen al compartir (ruta en /public); por defecto la de la RED
  imageAlt?: string;
  type?: string;       // og:type: website o article
}

const {
  title = 'RED Quynza · El derecho de la ciudad a la paz',
  noindex = false,
  image = '/img/og-redquynza.png',
  imageAlt = 'RED Quynza: la ciudad también tiene derecho a la paz',
  type = 'website',
  description = 'RED Quynza: más de 80 investigadores e investigadoras de más de 25 universidades que piensan la violencia urbana y la paz desde las ciudades de Colombia. Podcast, publicaciones y datos abiertos, documentales y boletín.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/publicaciones', label: 'Repositorio' },
  { href: '/videos', label: 'Videos' },
  { href: '/documentales', label: 'Documentales' },
  { href: '/boletin', label: 'Boletín' },
  { href: '/la-red', label: 'La RED' },
  { href: '/aportar', label: 'Aporta' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <!-- Vista previa al compartir (WhatsApp, Instagram, Facebook, X, LinkedIn…) -->
  <meta property="og:site_name" content="RED Quynza" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  {image === '/img/og-redquynza.png' && <meta property="og:image:width" content="1200" />}
  {image === '/img/og-redquynza.png' && <meta property="og:image:height" content="630" />}
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="apple-touch-icon" href="/img/logo-q.png" />
  <link rel="icon" type="image/png" href="/img/pajaro.png" />
  <meta name="theme-color" content="#0E3A42" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..800,0..100,0..1;1,9..144,300..800,0..100,0..1&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />
  <script is:inline>
    // el sitio abre en claro; el oscuro solo se activa con el botón y se recuerda
    (function () {
      var d = document.documentElement; d.classList.add('js');
      try { var t = localStorage.getItem('tema'); if (t === 'dark') d.setAttribute('data-theme', 'dark'); } catch (e) {}
    })();
  </script>
</head>
<body>
  <header class="top">
    <div class="wrap" style="position:relative">
      <a class="brand" href="/" aria-label="RED Quynza, inicio"><img src="/img/wordmark.png" alt="RED Quynza" width="760" height="135" /></a>
      <div class="tools">
        <button class="theme-btn" type="button" aria-label="Cambiar entre modo claro y oscuro" title="Modo claro / oscuro">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
        </button>
        <button class="menu-btn" aria-expanded="false" aria-controls="menu">Menú</button>
      </div>
      <nav id="menu" aria-label="Principal">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <slot />

  <footer>
    <div class="wrap">
      <div><img class="flogo" src="/img/logo-red-quynza-crema.png" alt="RED Quynza" /><span class="tag">Un contrapeso mediático.</span></div>
      <ul>
        <li><a href="https://www.youtube.com/@REDQuynza" target="_blank" rel="noopener">YouTube</a></li>
        <li><a href="https://www.instagram.com/redquynza/" target="_blank" rel="noopener">Instagram</a></li>
        <li><a href="https://www.tiktok.com/@red.quynza" target="_blank" rel="noopener">TikTok</a></li>
        <li><a href="https://www.facebook.com/profile.php?id=61591393226166" target="_blank" rel="noopener">Facebook</a></li>
        <li><a href="mailto:redquynza@gmail.com">redquynza@gmail.com</a></li>
      </ul>
      <span class="note">© 2026 RED Quynza</span>
    </div>
  </footer>

  <script is:inline>
    (function () {
      // --- Menú móvil: abrir/cerrar + cerrar al hacer clic afuera ---
      var btn = document.querySelector('.menu-btn');
      var nav = document.getElementById('menu');
      if (btn && nav) {
        var close = function () {
          nav.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        };
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = nav.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        // Cerrar al elegir un enlace
        nav.addEventListener('click', function (e) {
          if (e.target.tagName === 'A') close();
        });
        // Cerrar al hacer clic en cualquier otra zona de la página
        document.addEventListener('click', function (e) {
          if (!nav.classList.contains('open')) return;
          if (nav.contains(e.target) || btn.contains(e.target)) return;
          close();
        });
        // Cerrar con la tecla Escape
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close();
        });
      }

      // --- Formularios de boletín (puede haber más de uno por página) ---
      document.querySelectorAll('form.signup').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          // Si el form apunta a Buttondown (tiene action), dejamos que envíe normal.
          if (form.getAttribute('action')) return;
          e.preventDefault();
          var msg = document.getElementById(form.id + '-msg');
          if (msg) msg.textContent = 'El boletín todavía no está activo. El primer número sale pronto.';
        });
      });

      // --- Selector claro / oscuro ---
      var tb = document.querySelector('.theme-btn');
      if (tb) tb.addEventListener('click', function () {
        var d = document.documentElement;
        var oscuro = d.getAttribute('data-theme') === 'dark';
        var nuevo = oscuro ? 'light' : 'dark';
        d.setAttribute('data-theme', nuevo);
        try { localStorage.setItem('tema', nuevo); } catch (e) {}
      });

      // --- Animaciones: cabecera con sombra al bajar, aparición al hacer scroll, cifra que cuenta ---
      var header = document.querySelector('header.top');
      var onScroll = function () { if (header) header.classList.toggle('scrolled', window.scrollY > 8); };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      var quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if ('IntersectionObserver' in window && !quieto) {
        var sel = '.sec-head, .block > .wrap.sec-grid > *, .convo > *, .thesis .t-item, .pullquote, .pub, .teaser, .faces a, .member, .region-head, .docs li, .moments li, .videos .video, .benefits li, .dir-empty, .big';
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        document.querySelectorAll(sel).forEach(function (el) {
          if (el.closest('.hero') || el.closest('dialog')) return;
          if (el.getBoundingClientRect().top < window.innerHeight) return; // ya visible al cargar: sin animación
          var i = Array.prototype.indexOf.call(el.parentNode.children, el);
          el.style.setProperty('--d', Math.min(i, 8) * 0.07 + 's');
          el.classList.add('rv');
          io.observe(el);
        });
        window.addEventListener('beforeprint', function () {
          document.querySelectorAll('.rv').forEach(function (el) { el.classList.add('in'); });
        });
      } else {
        document.documentElement.classList.remove('js');
      }

      document.querySelectorAll('.big-num').forEach(function (el) {
        var t = el.firstChild;
        if (!t || t.nodeType !== 3) return;
        var m = t.nodeValue.match(/(\d+)/);
        if (!m || quieto) return;
        var fin = parseInt(m[1], 10), resto = t.nodeValue.replace(m[1], '{n}');
        // la cifra real queda en el HTML; solo se anima si el navegador pinta cuadros
        var t0 = null, dur = 1600;
        var paso = function (ts) {
          if (!t0) t0 = ts;
          var p = Math.min((ts - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3);
          t.nodeValue = resto.replace('{n}', Math.round(fin * e));
          if (p < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
        setTimeout(function () { t.nodeValue = resto.replace('{n}', fin); }, dur + 1500);
      });

      // --- Reproductor de YouTube embebido al hacer clic (si hay videos) ---
      document.querySelectorAll('.video[data-yt]').forEach(function (a) {
        a.addEventListener('click', function (e) {
          var t = a.querySelector('.thumb');
          if (!t || t.querySelector('iframe')) return;
          e.preventDefault();
          var f = document.createElement('iframe');
          f.src = 'https://www.youtube-nocookie.com/embed/' + a.dataset.yt + '?autoplay=1&rel=0';
          f.title = 'Video de RED Quynza';
          f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          f.allowFullscreen = true;
          t.innerHTML = '';
          t.appendChild(f);
        });
      });
    })();
  </script>
</body>
</html>
