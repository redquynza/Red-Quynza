---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'RED Quynza · El derecho de la ciudad a la paz',
  noindex = false,
  description = 'RED Quynza: más de 80 investigadores e investigadoras de más de 25 universidades que piensan la violencia urbana y la paz desde las ciudades de Colombia. Podcast, publicaciones y datos abiertos, documentales y boletín.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/img/og-redquynza.png', Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/publicaciones', label: 'Repositorio' },
  { href: '/videos', label: 'Videos' },
  { href: '/documentales', label: 'Documentales' },
  { href: '/boletin', label: 'Boletín' },
  { href: '/la-red', label: 'La RED' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <!-- Vista previa al compartir (WhatsApp, Instagram, Facebook, X, LinkedIn…) -->
  <meta property="og:site_name" content="RED Quynza" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="RED Quynza: la ciudad también tiene derecho a la paz" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="apple-touch-icon" href="/img/logo-q.png" />
  <link rel="icon" type="image/png" href="/img/pajaro.png" />
  <meta name="theme-color" content="#F7F4EE" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0C2328" media="(prefers-color-scheme: dark)" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Zilla+Slab:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <div class="wrap">
      <a class="brand" href="/" aria-label="RED Quynza, inicio"><img src="/img/wordmark.png" alt="RED Quynza" width="760" height="135" /></a>
      <button class="menu-btn" aria-expanded="false" aria-controls="menu"><i aria-hidden="true"></i>Menú</button>
      <nav id="menu" aria-label="Principal">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <slot />

  <footer>
    <div class="wrap">
      <div class="f-top">
        <div><img class="flogo" src="/img/wordmark-crema.png" alt="RED Quynza" width="760" height="135" loading="lazy" /></div>
        <div>
          <p class="tag">Un contrapeso mediático. Paz y cuidado de la vida.</p>
          <div class="f-cols">
            <div>
              <h4>Secciones</h4>
              <ul>{nav.filter((i) => i.href !== '/').map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
            </div>
            <div>
              <h4>Redes</h4>
              <ul>
                <li><a href="https://www.youtube.com/@REDQuynza" target="_blank" rel="noopener">YouTube</a></li>
                <li><a href="https://www.instagram.com/redquynza/" target="_blank" rel="noopener">Instagram</a></li>
                <li><a href="https://www.tiktok.com/@red.quynza" target="_blank" rel="noopener">TikTok</a></li>
                <li><a href="https://www.facebook.com/profile.php?id=61591393226166" target="_blank" rel="noopener">Facebook</a></li>
              </ul>
            </div>
            <div>
              <h4>Escríbenos</h4>
              <ul>
                <li><a href="mailto:redquynza@gmail.com">redquynza@gmail.com</a></li>
                <li><a href="https://zenodo.org/communities/redquynza/records" target="_blank" rel="noopener">Datos abiertos en Zenodo</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <div class="f-bottom"><span>© 2026 RED Quynza</span><span>Violencia urbana y paz desde las ciudades de Colombia</span></div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      // --- Menú móvil: abrir/cerrar + cerrar al hacer clic afuera ---
      var btn = document.querySelector('.menu-btn');
      var nav = document.getElementById('menu');
      if (btn && nav) {
        var close = function () {
          nav.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        };
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = nav.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        // Cerrar al elegir un enlace
        nav.addEventListener('click', function (e) {
          if (e.target.tagName === 'A') close();
        });
        // Cerrar al hacer clic en cualquier otra zona de la página
        document.addEventListener('click', function (e) {
          if (!nav.classList.contains('open')) return;
          if (nav.contains(e.target) || btn.contains(e.target)) return;
          close();
        });
        // Cerrar con la tecla Escape
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close();
        });
      }

      // --- Formularios de boletín (puede haber más de uno por página) ---
      document.querySelectorAll('form.signup').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          // Si el form apunta a Buttondown (tiene action), dejamos que envíe normal.
          if (form.getAttribute('action')) return;
          e.preventDefault();
          var msg = document.getElementById(form.id + '-msg');
          if (msg) msg.textContent = 'El boletín todavía no está activo. El primer número sale pronto.';
        });
      });

      // --- Reproductor de YouTube embebido al hacer clic (si hay videos) ---
      document.querySelectorAll('.film[data-yt]').forEach(function (a) {
        a.addEventListener('click', function (e) {
          var t = a.querySelector('.thumb');
          if (!t || t.querySelector('iframe')) return;
          e.preventDefault();
          var f = document.createElement('iframe');
          f.src = 'https://www.youtube-nocookie.com/embed/' + a.dataset.yt + '?autoplay=1&rel=0';
          f.title = 'Video de RED Quynza';
          f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          f.allowFullscreen = true;
          t.innerHTML = '';
          t.appendChild(f);
        });
      });
    })();
  </script>
</body>
</html>
