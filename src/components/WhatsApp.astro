---
// Botón fijo de WhatsApp: abre el chat con Martín con un mensaje ya escrito.
// Arriba de la página va con texto; al bajar se encoge al ícono y vuelve a abrirse al subir
// o al pasar el mouse. Se esconde cuando el pie está en pantalla.
const NUMERO = '573104813624';
const MENSAJE = 'Hola, Martín. Vi la página de la RED Quynza y quiero hacer una consulta.';
const href = `https://wa.me/${NUMERO}?text=${encodeURIComponent(MENSAJE)}`;
---

<a class="wa" href={href} target="_blank" rel="noopener" data-wa aria-label="Escribir a la RED Quynza por WhatsApp, +57 310 481 3624">
  <svg class="wa-icono" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <path
      fill="currentColor"
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
    ></path>
  </svg>
  <span class="wa-texto">Escríbenos</span>
</a>

<script>
  const boton = document.querySelector<HTMLElement>('[data-wa]');
  if (boton) {
    let antes = window.scrollY;
    // En el celular va siempre como ícono: con texto tapaba el formulario del boletín de la portada.
    const movil = matchMedia('(max-width: 600px)');
    const revisar = () => {
      const y = window.scrollY;
      if (movil.matches) boton.classList.add('compacto');
      else if (y < window.innerHeight * 0.5) boton.classList.remove('compacto');
      else if (y > antes + 6) boton.classList.add('compacto');
      else if (y < antes - 6) boton.classList.remove('compacto');
      antes = y;
    };
    window.addEventListener('scroll', revisar, { passive: true });
    revisar();
    const pie = document.querySelector('footer');
    if (pie)
      new IntersectionObserver(([e]) => boton.classList.toggle('oculto', e.isIntersecting), {
        rootMargin: '0px 0px -40px 0px',
      }).observe(pie);
  }
</script>

<style>
  .wa {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 80;
    display: inline-flex;
    align-items: center;
    height: 52px;
    padding: 0 1.15rem 0 1rem;
    border-radius: 999px;
    /* tinta sobre papel (crema en el modo oscuro): contrasta también sobre las tarjetas teal */
    background: var(--ink);
    color: var(--bg);
    /* aro teal fino: lo separa también de las franjas oscuras */
    box-shadow:
      0 0 0 1.5px rgba(3, 190, 192, 0.55),
      0 14px 30px -12px rgba(4, 23, 27, 0.65);
    font: 600 0.95rem/1 var(--sans);
    text-decoration: none;
    transition:
      background 0.25s,
      color 0.25s,
      padding 0.4s var(--ease),
      opacity 0.35s var(--ease),
      translate 0.35s var(--ease);
  }
  .wa-icono {
    flex: none;
    color: var(--teal);
  }
  :global(:root[data-theme='dark']) .wa-icono {
    color: #007a7d; /* el teal del modo claro: legible sobre el botón crema */
  }
  .wa:hover .wa-icono,
  .wa:focus-visible .wa-icono {
    color: currentColor;
  }
  .wa-texto {
    max-width: 10em;
    margin-left: 0.55rem;
    overflow: hidden;
    white-space: nowrap;
    transition:
      max-width 0.4s var(--ease),
      margin 0.4s var(--ease),
      opacity 0.25s;
  }
  .wa.compacto:not(:hover):not(:focus-visible) {
    padding: 0 15px;
  }
  .wa.compacto:not(:hover):not(:focus-visible) .wa-texto {
    max-width: 0;
    margin-left: 0;
    opacity: 0;
  }
  .wa:hover,
  .wa:focus-visible {
    background: var(--coral);
    color: var(--on-coral);
  }
  .wa:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .wa.oculto {
    opacity: 0;
    translate: 0 12px;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .wa,
    .wa-texto {
      transition: none;
    }
  }
  @media print {
    .wa {
      display: none;
    }
  }
</style>
