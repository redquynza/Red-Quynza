---
import Base from '../layouts/Base.astro';
import { cargar, ZENODO, htmlTipos, htmlNodos, htmlTemas, htmlRecientes, htmlVideos } from '../lib/zenodo';

// El catálogo completo vive en Zenodo; aquí se muestra un resumen que se arma al construir
// el sitio y se actualiza en el navegador (ver src/lib/zenodo.ts).
const d = await cargar(fetch, true);
---
<Base
  title="Repositorio abierto sobre violencia urbana y paz: artículos y datos · RED Quynza"
  description="Repositorio abierto de la RED Quynza en Zenodo: artículos, capítulos, informes, bases de datos y videos sobre violencia urbana y paz en Colombia, enviados por los nodos de la red."
>
  <main>
    <section class="block tint-teal" id="repositorio">
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">Repositorio abierto</p><h1 class="como-h2">Lo que investiga la red, en un solo lugar</h1></div>
          <div>
            <p class="intro">Artículos, capítulos, informes, bases de datos y videos que envían los nodos de la red. Están guardados en <b>Zenodo</b>, el repositorio abierto del CERN: cada documento tiene su DOI para citarlo y se descarga gratis.</p>
            <p class="repo-total"><span id="repo-total">{d ? d.total : '—'}</span> documentos publicados</p>
          </div>
        </div>
        <form class="repo-buscar" action={ZENODO} method="get" target="_blank" role="search">
          <label class="sr" for="repo-q">Buscar en el repositorio</label>
          <input id="repo-q" name="q" type="search" placeholder="Busca por tema, autor, ciudad…" autocomplete="off" />
          <button class="btn solid" type="submit">Buscar en Zenodo</button>
        </form>
        <div class="repo-explora">
          <h3 class="sub-head">Por tipo de documento</h3>
          <div class="facetas" id="repo-tipos" set:html={d ? htmlTipos(d) : ''}></div>
          <p class="repo-todo"><a class="text-link" href={ZENODO} target="_blank" rel="noopener">Ver el repositorio completo en Zenodo ↗</a></p>
        </div>
      </div>
    </section>

    <section class="block" id="recientes">
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">Lo más reciente</p><h2>Últimos documentos</h2></div>
          <p class="intro">Lo último que llegó al repositorio. Cada ficha abre el documento en Zenodo.</p>
        </div>
        <div class="fichas" id="repo-recientes" set:html={d ? htmlRecientes(d) : ''}></div>
        {!d && <div class="dir-empty"><p>No pudimos cargar el repositorio. <a href={ZENODO} target="_blank" rel="noopener">Ábrelo directamente en Zenodo</a>.</p></div>}
      </div>
    </section>

    <section class="block tint-sand" id="nodos">
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">Desde los territorios</p><h2>Por nodo y por tema</h2></div>
          <p class="intro">La red se organiza en siete macrorregiones. Cada nodo envía lo que investiga en su territorio.</p>
        </div>
        <div class="nodos-f" id="repo-nodos" set:html={d ? htmlNodos(d) : ''}></div>
        <h3 class="sub-head" style="margin-top:clamp(2.5rem,5vw,3.5rem)">Temas frecuentes</h3>
        <div class="temas" id="repo-temas" set:html={d ? htmlTemas(d) : ''}></div>
      </div>
    </section>

    <section class="block" id="videos" hidden={d && d.videos.length === 0 ? true : undefined}>
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">Videos</p><h2>Voces y experiencias de paz en video</h2></div>
          <p class="intro">Entrevistas y procesos de los territorios. Se reproducen aquí mismo; cada uno tiene su ficha en el repositorio.</p>
        </div>
        <div class="videos" id="repo-videos" set:html={d ? htmlVideos(d) : ''}></div>
      </div>
    </section>

    <section class="block tint-sand" id="publicaciones">
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">Documentos de la red</p><h2>Lo que la RED ha publicado</h2></div>
          <p class="intro">El libro, la propuesta política y el documento que explica quiénes somos.</p>
        </div>
        <div class="pubs">
          <article class="pub">
            <div class="cover"><img src="/img/libro-construir-la-paz.jpg" alt="Portada del libro Construir la paz y cuidar la vida" /></div>
            <h3>Construir la paz y cuidar la vida</h3>
            <p class="sub">Recomendaciones para el Plan Nacional de Desarrollo 2022-2026</p>
            <p>Propuestas para que el Plan Nacional de Desarrollo sirva a un nuevo pacto de nación en torno a la paz. Coordinación académica de Carlos Mario Perea y Socorro Ramírez Vargas. Editorial Universidad Nacional de Colombia.</p>
            <a class="go" href="https://portaldelibros.unal.edu.co/gpd-construir-la-paz-y-cuidar-la-vida-9789584983725-682b47c64f7e7.html" target="_blank" rel="noopener">Ver el libro</a>
          </article>
          <article class="pub">
            <div class="cover made c1" aria-hidden="true">
              <div><div class="bar"></div><div class="ct">Un renovado imaginario</div><div class="cs">El derecho de la ciudad a la paz</div></div>
              <div class="cf"><span>Propuesta política</span><img src="/img/pajaro.png" alt="" /></div>
            </div>
            <h3>Un renovado imaginario</h3>
            <p class="sub">El derecho de la ciudad a la paz</p>
            <p>La propuesta política de la red: por qué la ciudad tiene que entrar en la agenda de la paz.</p>
            <a class="go" href="https://docs.google.com/document/d/1yssSov4juOO9YGkE86LgucL5dJqbhKNl/edit?usp=sharing&amp;ouid=106186130985956628274&amp;rtpof=true&amp;sd=true" target="_blank" rel="noopener">Leer la propuesta</a>
          </article>
          <article class="pub">
            <div class="cover made c2" aria-hidden="true">
              <div><div class="bar"></div><div class="ct">La RED Quynza</div><div class="cs">Quiénes somos y cómo trabajamos</div></div>
              <div class="cf"><span>Documento orgánico</span><img src="/img/pajaro.png" alt="" /></div>
            </div>
            <h3>Documento orgánico</h3>
            <p class="sub">Quiénes somos y cómo trabajamos</p>
            <p>Qué es la RED Quynza, qué la mueve y cómo se organiza.</p>
            <a class="go" href="https://drive.google.com/file/d/1-Lh_lXeB1owqcAKhCjpyKl_hAii-_XzP/view?usp=sharing" target="_blank" rel="noopener">Leer el documento</a>
          </article>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // Trae de Zenodo lo más nuevo para que la página no dependa de volver a desplegar.
  import { cargar, htmlTipos, htmlTemas, htmlRecientes, htmlVideos } from '../lib/zenodo';
  const poner = (id: string, html: string) => {
    const el = document.getElementById(id);
    if (el && el.innerHTML.trim() !== html.trim()) el.innerHTML = html;
  };
  cargar().then((d) => {
    if (!d) return;
    const total = document.getElementById('repo-total');
    if (total) total.textContent = String(d.total);
    poner('repo-tipos', htmlTipos(d));
    poner('repo-recientes', htmlRecientes(d));
    poner('repo-temas', htmlTemas(d)); // los nodos se quedan como vinieron del build
    // los videos solo se tocan si cambió la lista, para no cortar uno que se esté viendo
    const v = document.getElementById('repo-videos');
    if (v && !v.querySelector('iframe')) poner('repo-videos', htmlVideos(d));
    const sec = document.getElementById('videos');
    if (sec) sec.hidden = d.videos.length === 0;
  });
</script>
