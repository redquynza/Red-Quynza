---
import Base from '../layouts/Base.astro';
import { textos, videos, tipos, publicadosEnZenodo, zenodoUrl } from '../data/repositorio';

const ZENODO = 'https://zenodo.org/communities/redquynza/records';
const publicados = await publicadosEnZenodo([...textos, ...videos].map((x) => x.zenodo));
---
<Base
  title="Repositorio · RED Quynza"
  description="Repositorio de la RED Quynza: libros, artículos, capítulos, informes, videos y las bases de datos de sus investigaciones sobre violencia urbana y paz en Colombia. Acceso abierto."
>
  <main>
    <section class="block" id="publicaciones">
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">Repositorio</p><h2>Publicaciones y datos de la red</h2></div>
          <p class="intro">Libros y artículos propios de la red, y los archivos con los que investigamos: bases de datos, informes y documentos de trabajo. Todo en acceso abierto.</p>
        </div>
        <h3 class="sub-head">Libros y documentos</h3>
        <div class="pubs">
          <article class="pub">
            <div class="cover"><img src="/img/libro-construir-la-paz.jpg" alt="Portada del libro Construir la paz y cuidar la vida" /></div>
            <h3>Construir la paz y cuidar la vida</h3>
            <p class="sub">Recomendaciones para el Plan Nacional de Desarrollo 2022-2026</p>
            <p>Propuestas para que el Plan Nacional de Desarrollo sirva a un nuevo pacto de nación en torno a la paz. Coordinación académica de Carlos Mario Perea y Socorro Ramírez Vargas. Editorial Universidad Nacional de Colombia.</p>
            <a class="go" href="https://portaldelibros.unal.edu.co/gpd-construir-la-paz-y-cuidar-la-vida-9789584983725-682b47c64f7e7.html" target="_blank" rel="noopener">Ver el libro</a>
          </article>
          <article class="pub">
            <div class="cover made c1" aria-hidden="true">
              <div><div class="bar"></div><div class="ct">Un renovado imaginario</div><div class="cs">El derecho de la ciudad a la paz</div></div>
              <div class="cf"><span>Propuesta política</span><img src="/img/pajaro.png" alt="" /></div>
            </div>
            <h3>Un renovado imaginario</h3>
            <p class="sub">El derecho de la ciudad a la paz</p>
            <p>La propuesta política de la red: por qué la ciudad tiene que entrar en la agenda de la paz.</p>
            <a class="go" href="https://docs.google.com/document/d/1yssSov4juOO9YGkE86LgucL5dJqbhKNl/edit?usp=sharing&amp;ouid=106186130985956628274&amp;rtpof=true&amp;sd=true" target="_blank" rel="noopener">Leer la propuesta</a>
          </article>
          <article class="pub">
            <div class="cover made c2" aria-hidden="true">
              <div><div class="bar"></div><div class="ct">La RED Quynza</div><div class="cs">Quiénes somos y cómo trabajamos</div></div>
              <div class="cf"><span>Documento orgánico</span><img src="/img/pajaro.png" alt="" /></div>
            </div>
            <h3>Documento orgánico</h3>
            <p class="sub">Quiénes somos y cómo trabajamos</p>
            <p>Qué es la RED Quynza, qué la mueve y cómo se organiza.</p>
            <a class="go" href="https://drive.google.com/file/d/1-Lh_lXeB1owqcAKhCjpyKl_hAii-_XzP/view?usp=sharing" target="_blank" rel="noopener">Leer el documento</a>
          </article>
        </div>
      </div>
    </section>

    <section class="block tint-sand" id="articulos">
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">Desde los nodos</p><h2>Lo que investigan los integrantes de la red</h2></div>
          <p class="intro">Artículos, capítulos e informes que los nodos han enviado al repositorio. Cada texto queda guardado en Zenodo, citable y de libre descarga.</p>
        </div>
        {Object.entries(tipos).map(([tipo, nombre]) => {
          const lista = textos.filter((t) => t.tipo === tipo);
          return lista.length > 0 && (
            <div class="fondo-grupo">
              <h3 class="sub-head">{nombre} <span class="n">{lista.length}</span></h3>
              <ol class="fondo">
                {lista.map((t) => {
                  const enZenodo = publicados.has(t.zenodo);
                  return (
                    <li>
                      <div class="meta"><span class="anio">{t.anio}</span><span class="nodo">Nodo {t.nodo}</span></div>
                      <div class="cuerpo">
                        <h4>{enZenodo ? <a href={zenodoUrl(t.zenodo)} target="_blank" rel="noopener">{t.titulo}</a> : t.titulo}</h4>
                        <p class="autores">{t.autores.map((a, i) => <>{i > 0 && ', '}{a.id ? <a href={`/la-red#${a.id}`}>{a.nombre}</a> : a.nombre}</>)}</p>
                        <p class="de-que">{t.resumen}</p>
                        <p class="fuente">{t.fuente} · {t.territorio}</p>
                      </div>
                      <div class="acc">
                        {enZenodo
                          ? <a class="go" href={zenodoUrl(t.zenodo)} target="_blank" rel="noopener">Descargar</a>
                          : t.original
                            ? <a class="go" href={t.original.href} target="_blank" rel="noopener">{t.original.label}</a>
                            : <span class="pronto">Pronto en Zenodo</span>}
                        <span class="lic">{t.licencia}</span>
                      </div>
                    </li>
                  );
                })}
              </ol>
            </div>
          );
        })}
      </div>
    </section>

    <section class="block" id="videos">
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">Videos</p><h2>Voces y experiencias de paz en video</h2></div>
          <p class="intro">Entrevistas y procesos de los territorios que la red recomienda ver. Se reproducen aquí mismo; cada uno tiene su ficha en el repositorio.</p>
        </div>
        <div class="videos">
          {videos.map((v) => (
            <div class="video-item">
              <a class="video" data-yt={v.yt} href={`https://youtu.be/${v.yt}`} target="_blank" rel="noopener" aria-label={`Ver en YouTube: ${v.titulo}`}>
                <span class="thumb"><img src={`https://i.ytimg.com/vi/${v.yt}/hqdefault.jpg`} alt="" loading="lazy" /><span class="play" aria-hidden="true"></span></span>
              </a>
              <h3>{v.titulo}</h3>
              <p class="vmeta">{v.canal} · {v.anio} · {v.duracion} · {v.territorio}</p>
              <p>{v.resumen}</p>
              {(v.conversan || publicados.has(v.zenodo)) && (
                <p class="vmeta">
                  {v.conversan && <>Con {v.conversan.map((a) => a.id ? <a href={`/la-red#${a.id}`}>{a.nombre}</a> : a.nombre)}, integrante de la red.</>}
                  {publicados.has(v.zenodo) && <> <a href={zenodoUrl(v.zenodo)} target="_blank" rel="noopener">Ficha en Zenodo ↗</a></>}
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="block tint-teal" id="repositorio">
      <div class="wrap sec-grid">
        <div>
          <p class="kicker">Datos abiertos</p>
          <h2>Las bases de datos de nuestras investigaciones</h2>
        </div>
        <div>
          <p class="intro" style="max-width:52ch">La RED publica en <b>Zenodo</b> las bases de datos usadas en sus investigaciones, junto con informes y documentos de trabajo. Acceso libre, citable y con DOI.</p>
          {ZENODO
            ? <p style="margin-top:1.4rem"><a class="btn solid" href={ZENODO} target="_blank" rel="noopener">Ver el repositorio en Zenodo</a></p>
            : <div class="dir-empty" style="margin-top:1.4rem"><p>El repositorio en Zenodo estará enlazado aquí muy pronto.</p></div>
          }
        </div>
      </div>
    </section>
  </main>
</Base>
