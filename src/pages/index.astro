---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';

// Macrorregiones de la red (según el documento orgánico).
const regiones = [
  { id: 'caribe', nombre: 'Caribe' },
  { id: 'oriente', nombre: 'Oriente' },
  { id: 'centro', nombre: 'Zona Centro' },
  { id: 'cafetera', nombre: 'Zona Cafetera' },
  { id: 'pacifico', nombre: 'Pacífico' },
  { id: 'orinoquia', nombre: 'Orinoquía' },
  { id: 'amazonia', nombre: 'Amazonía' },
];

// Directorio de integrantes. Se llenará cuando lleguen los datos.
// Formato: { nombre, rol, universidad, region: <id>, foto?: '/img/miembros/xxx.jpg' }
const miembros: { nombre: string; rol: string; universidad: string; region: string; foto?: string }[] = [];

const iniciales = (n: string) =>
  n.split(' ').filter(Boolean).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
const porRegion = (id: string) => miembros.filter((m) => m.region === id);
---
<Base>
  <main id="inicio">
    <!-- HÉROE -->
    <section class="hero">
      <!-- Boletín: la acción prioritaria, arriba de todo -->
      <div class="wrap hero-signup" id="suscribirse">
        <div>
          <p class="hs-label"><i>Gratis</i> Boletín mensual</p>
          <p class="hs-title">Lo que la red piensa y hace, una vez al mes en tu correo.<span>Análisis con criterio sobre violencia urbana y paz, más el podcast, los documentales y la agenda de la red.</span></p>
        </div>
        <div>
          <Signup id="signup" cta="Quiero recibirlo" />
        </div>
      </div>

      <div class="wrap">
        <div>
          <p class="tagline">Paz y cuidado de la vida</p>
          <h1>La ciudad también tiene <em>derecho a la paz</em></h1>
          <p class="lede">La guerra no se tomó la ciudad. Pero allí ocurren <b>más de la mitad de los homicidios del país</b>, y casi nunca entra en las conversaciones de paz.</p>
          <p class="lede-2">Somos más de 80 investigadores e investigadoras de más de 25 universidades que pensamos la violencia urbana desde las ciudades de Colombia. Nuestro Centro de Pensamiento Digital la lleva a la conversación pública: boletín, podcast, documentales y publicaciones abiertas.</p>
          <div class="actions">
            <a class="btn solid" href="/boletin">Recibir el boletín</a>
            <a class="text-link" href="#tesis">Leer la tesis ↓</a>
          </div>
        </div>
        <aside class="statcard" aria-label="Dato clave">
          <div class="big-num">58%<small>de los homicidios del país ocurren en las ciudades</small></div>
          <blockquote>La ciudad produce grandes violencias y, no obstante, se mantiene enterrada en el olvido.</blockquote>
          <span class="src">RED Quynza · El derecho de la ciudad a la paz</span>
        </aside>
      </div>
    </section>

    <!-- TESIS -->
    <section class="block ink" id="tesis">
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">La tesis</p><h2>Pensar solo la guerra no nos sacó de la violencia</h2></div>
          <p class="intro">Falta mirar la ciudad. Tres ideas para un renovado imaginario de la paz.</p>
        </div>
        <div class="thesis">
          <div class="t-item">
            <h3>La paradoja urbana</h3>
            <p>Cuatro de cada cinco colombianos viven en ciudades, que concentran más de la mitad de los homicidios. Aun así, lo urbano quedó fuera del relato de la guerra y de la paz.</p>
          </div>
          <div class="t-item">
            <h3>Otras violencias</h3>
            <p>La violencia de la ciudad no la produce solo la confrontación armada. Reconocer su singularidad obliga a mirar con otros ojos y a nombrar lo que el imaginario armado borró.</p>
          </div>
          <div class="t-item">
            <h3>El derecho a la paz</h3>
            <p>Equidad, transformación cultural y empoderamiento de la sociedad como pilares de la no violencia y el cuidado de la vida.</p>
          </div>
        </div>
        <p class="pullquote">Sin la ciudad <span>no hay paz completa.</span></p>
      </div>
    </section>

    <!-- TEASERS -->
    <section class="block" id="explora">
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">Centro de Pensamiento Digital</p><h2>Investigación que se escucha, se ve y se lee</h2></div>
          <p class="intro">Llevamos lo que investigamos a donde hoy se forma la opinión pública.</p>
        </div>
        <div class="teasers">
          <a class="teaser" href="/podcast">
            <span class="tk">Podcast</span>
            <h3>Un viaje por Colombia</h3>
            <p>Conversación a conversación, un mapa del país que se llena con cada episodio.</p>
            <span class="arrow">Escuchar →</span>
          </a>
          <a class="teaser" href="/videos">
            <span class="tk">Videos</span>
            <h3>Empieza por aquí</h3>
            <p>Dos videos cortos para entender la red y su punto de partida.</p>
            <span class="arrow">Ver →</span>
          </a>
          <a class="teaser" href="/documentales">
            <span class="tk">Documentales</span>
            <h3>Historias con tiempo</h3>
            <p>Las piezas mayores de la red, filmadas donde ocurren: Pereira, Barranquilla, Cali.</p>
            <span class="arrow">Descubrir →</span>
          </a>
          <a class="teaser" href="/publicaciones">
            <span class="tk">Publicaciones</span>
            <h3>Libros y datos abiertos</h3>
            <p>El libro de la red, la propuesta política y el repositorio abierto en Zenodo.</p>
            <span class="arrow">Leer →</span>
          </a>
          <a class="teaser" href="/la-red">
            <span class="tk">La RED</span>
            <h3>Quiénes somos</h3>
            <p>Una academia comprometida y plural, con la paz como corazón.</p>
            <span class="arrow">Conocer →</span>
          </a>
          <a class="teaser" href="#directorio">
            <span class="tk">Integrantes</span>
            <h3>La red en el territorio</h3>
            <p>Más de 80 investigadores e investigadoras en las siete macrorregiones del país.</p>
            <span class="arrow">Ver directorio →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- BOLETÍN -->
    <section class="band coral" id="boletin-cta">
      <div class="wrap sec-grid">
        <div>
          <p class="kicker">Boletín</p>
          <h2>La política se decide hoy en el territorio digital</h2>
        </div>
        <div>
          <p class="intro" style="margin-bottom:1.6rem">Quien no disputa ese espacio se lo cede a la desinformación. Una vez al mes, en tu correo: análisis con criterio, el podcast, los documentales y la agenda de la red.</p>
          <Signup id="signup-2" />
          <p class="signup-fine">Gratis · Te das de baja cuando quieras</p>
        </div>
      </div>
    </section>

    <!-- DIRECTORIO -->
    <section class="block tint-teal" id="directorio">
      <div class="wrap">
        <div class="sec-grid sec-head">
          <div><p class="kicker">La red en el territorio</p><h2>Directorio de integrantes</h2></div>
          <p class="intro">Más de 80 investigadores e investigadoras de más de 25 universidades, organizados por las siete macrorregiones del país.</p>
        </div>

        <nav class="region-nav" aria-label="Regiones de la red">
          {regiones.map((r) => <a href={`#region-${r.id}`}>{r.nombre}</a>)}
        </nav>

        {miembros.length === 0 ? (
          <>
            <div class="dir-empty">
              <p><b>Directorio en construcción.</b> Estamos recogiendo los datos —fotografía y una breve reseña— de las y los más de 80 integrantes. Se publicarán aquí, organizados por región. Así se verá:</p>
            </div>
            <div class="region" id="region-preview" style="margin-top:2.5rem">
              <div class="region-head">
                <h3>Zona Centro <span class="preview-note">vista previa del diseño</span></h3>
                <span class="count">— integrantes</span>
              </div>
              <div class="members">
                {Array.from({ length: 4 }).map(() => (
                  <div class="member" aria-hidden="true">
                    <div class="photo"><span class="initials">·</span></div>
                    <p class="name">Nombre del integrante</p>
                    <p class="role">Rol · línea de trabajo</p>
                    <p class="uni">Universidad</p>
                  </div>
                ))}
              </div>
            </div>
          </>
        ) : (
          regiones.map((r) => {
            const ms = porRegion(r.id);
            if (ms.length === 0) return null;
            return (
              <div class="region" id={`region-${r.id}`}>
                <div class="region-head">
                  <h3>{r.nombre}</h3>
                  <span class="count">{ms.length} {ms.length === 1 ? 'integrante' : 'integrantes'}</span>
                </div>
                <div class="members">
                  {ms.map((m) => (
                    <div class="member">
                      <div class="photo">
                        {m.foto ? <img src={m.foto} alt={m.nombre} loading="lazy" /> : <span class="initials">{iniciales(m.nombre)}</span>}
                      </div>
                      <p class="name">{m.nombre}</p>
                      <p class="role">{m.rol}</p>
                      <p class="uni">{m.universidad}</p>
                    </div>
                  ))}
                </div>
              </div>
            );
          })
        )}
      </div>
    </section>
  </main>
</Base>
